HackerRank link:https://www.hackerrank.com/challenges/python-tuples/problem

n = int(input())
t = tuple(map(int, input().split()))

x = 0x345678
mult = 1000003
length = len(t)

for item in t:
    x = (x ^ hash(item)) * mult
    length -= 1
    mult += 82520 + length + length

x += 97531

# Convert to a signed 64-bit integer
x &= (1 << 64) - 1
if x >= (1 << 63):
    x -= (1 << 64)

if x == -1:
    x = -2

print(x)
